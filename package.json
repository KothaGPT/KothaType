{
  "private": true,
  "name": "kothatype-monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --parallel test",
    "test:watch": "pnpm -r --parallel test:watch",
    "test:coverage": "pnpm -r --parallel test:coverage",
    "test:ci": "pnpm -r --parallel --reporter=tap test",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "clean": "pnpm -r exec rm -rf dist coverage .turbo node_modules/.cache",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "baseline-browser-mapping": "^2.10.40",
    "c8": "^7.12.0",
    "esbuild": "^0.19.0",
    "@khulnasoft/style-guide": "^4.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.8.0",
    "prettier": "^2.8.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^4.0.0",
    "vitest": "^1.1.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
